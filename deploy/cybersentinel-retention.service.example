# Deletes expired sessions, old telemetry/alerts, and expired pending TXT challenges.
[Unit]
Description=CyberSentinel private owner data retention
After=cybersentinel-owner.service

[Service]
Type=oneshot
User=cybersentinel
Group=cybersentinel
WorkingDirectory=/opt/cybersentinel/app
Environment=CYBERSENTINEL_OWNER_DB=/var/lib/cybersentinel/owner.sqlite3
ExecStart=/opt/cybersentinel/venv/bin/python -m scripts.step15_ops retention --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cybersentinel
UMask=0077
