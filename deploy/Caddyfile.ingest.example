# CyberSentinel Step 14 - STAGING ONLY
# Set INGEST_HOST to an actual DNS hostname pointing at your VPS.
# Requires Caddy v2.10 or later for request_body/max_size.
# This listener never proxies /owner, /docs or any other application routes.
{$INGEST_HOST} {
    @ingest {
        method POST
        path /agent/v1/ingest
    }
    handle @ingest {
        request_body {
            max_size 32KB
        }
        reverse_proxy 127.0.0.1:8004 {
            header_up Host 127.0.0.1:8004
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
        }
    }
    handle {
        respond "Not found" 404
    }
}
